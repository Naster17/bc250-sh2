#!/usr/bin/env python3
"""Publish AMD GPU utilisation for the performance overlay.

The overlay in gaming mode is MangoHud (`mangoapp`, spawned by gamescope), and
Steam's own overlay reads the same sysfs node. Both want a percentage that the
BC-250 cannot provide directly:

  * `/sys/class/drm/card0/device/gpu_busy_percent` — the amdgpu driver answers
    this read with `EOPNOTSUPP` on GFX1013 (no per-ASIC switch exists);
  * `/sys/class/drm/card0/device/gpu_metrics` — a 128-byte binary table whose
    `average_gfx_activity` (offset 28, `format_revision=2`) is `0xFFFF` whenever
    the SMU has no sample. MangoHud divides anything above 100 by 100
    (centipercent heuristic), so a single `0xFFFF` renders as `655%`, and it
    prefers this table over `gpu_busy_percent` on every poll.

This daemon keeps both files sane inside the container (bind-mounted shadows,
see docker-compose.yml):

  * `gpu_metrics` is rewritten every cycle from the real table: temperatures,
    clocks and power pass through untouched, only the activity field is
    replaced. The percentage comes from the driver's own centipercent value when
    it is valid — that is exactly what amdgpu_top displays — and from the
    per-client `drm-engine-gfx` counters in `/proc/<pid>/fdinfo/<fd>` when the
    SMU reports `0xFFFF`. Counters are de-duplicated by `drm-client-id`: every
    descriptor of a client repeats the same cumulative value, and summing per fd
    inflates the result several times over.
  * `gpu_busy_percent` gets the same percentage as plain text for readers that
    use it (Steam's overlay, MangoHud's sysfs fallback).

Values are written in place at a fixed width so a concurrent reader never sees a
truncated file.
"""

from __future__ import annotations

import os
import subprocess
import sys
import time
from pathlib import Path

OUT = Path(os.environ.get("GPU_LOAD_FILE", "/run/gpu-metrics/gpu_busy_percent"))
METRICS_REAL = Path(os.environ.get("GPU_METRICS_REAL", "/run/gpu-live/gpu_metrics"))
METRICS_OUT = Path(os.environ.get("GPU_METRICS_FILE", "/run/gpu-metrics/gpu_metrics"))
FREQ_OUT = Path(os.environ.get("GPU_FREQ_FILE", "/run/gpu-metrics/freq1_input"))
# The governor's patched hwmon attribute, read through the host's mount tree so
# that overlays re-created by a governor restart are always the current ones.
HOST_ROOT = Path(os.environ.get("GPU_HOST_ROOT", "/host-proc/1/root"))
CLOCK_CACHE: Path | None = None
HWMON_ROOT = Path("/sys/class/hwmon")
INTERVAL = float(os.environ.get("GPU_LOAD_INTERVAL", "0.5"))

# `average_gfx_activity` in the 128-byte v2.x table: header 4 + gfx/soc
# temperature 4 + core temperatures 16 + l3 temperatures 4.
ACTIVITY_OFFSET = 28
# `average_gfxclk_frequency` and `current_gfxclk` in MHz.
AVG_GFXCLK_OFFSET = 64
GFXCLK_OFFSET = 76
# The BC-250 unlock corrupts both clock sources with values in the 2..100 MHz
# range, and the raw attribute briefly reads 100 while the governor re-creates
# its overlay on a power plan change. The governor itself never commands less
# than 350 MHz, so a 200 MHz floor rejects the corruption without hiding a real
# low-power state.
CLOCK_MIN_MHZ = 200
CLOCK_MAX_MHZ = 3000

ENGINE = b"drm-engine-gfx:"
CLIENT = b"drm-client-id:"
WIDTH = 3  # "NN\n"


def driver_activity() -> int | None:
    """GPU load in percent from the driver table, or None when invalid.

    amdgpu reports centipercent (5470 == 54.70%) and 0xFFFF for "no sample".
    """
    try:
        table = METRICS_REAL.read_bytes()
    except OSError:
        return None
    if len(table) < ACTIVITY_OFFSET + 2:
        return None
    raw = table[ACTIVITY_OFFSET] | (table[ACTIVITY_OFFSET + 1] << 8)
    if raw == 0xFFFF:
        return None
    return min(100, (raw + 50) // 100)


def snapshot() -> dict[tuple, int]:
    """Cumulative gfx engine time (ns) per DRM client in this namespace."""
    usage: dict[tuple, int] = {}
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit():
            continue
        pid = int(entry.name)
        fdinfo = entry / "fdinfo"
        try:
            fds = os.listdir(fdinfo)
        except OSError:
            continue
        for fd in fds:
            try:
                with open(fdinfo / fd, "rb") as handle:
                    data = handle.read()
            except OSError:
                continue
            if ENGINE not in data:
                continue
            client = None
            engine = None
            for line in data.splitlines():
                if client is None and line.startswith(CLIENT):
                    client = line[len(CLIENT):].strip()
                elif engine is None and line.startswith(ENGINE):
                    value = line[len(ENGINE):].strip()
                    if value.endswith(b" ns"):
                        value = value[:-3]
                    try:
                        engine = int(value)
                    except ValueError:
                        engine = None
            if engine is None:
                continue
            key = ("client", client) if client else ("fd", pid, int(fd))
            usage[key] = engine
    return usage


def publish(percent: int) -> None:
    payload = f"{percent:02d}\n".encode()
    with open(OUT, "r+b") as handle:
        handle.seek(0)
        handle.write(payload)
        handle.truncate(WIDTH)


def drop_stale_shadows() -> None:
    """Unmount tmpfs copies that sit on top of the live driver directory.

    Earlier experiments bind-mounted patched copies over `/run/gpu-device/*` and
    then unlinked the sources, which leaves the whole read path frozen at the
    values from whenever that happened: the clock never moves, temperatures and
    power repeat forever. The compose mount itself is sysfs, so only tmpfs
    children are dropped.
    """
    prefixes = ("/run/gpu-live/", "/run/gpu-device/")
    for line in Path("/proc/self/mountinfo").read_text().splitlines():
        left, _, right = line.partition(" - ")
        fields = left.split()
        if len(fields) < 5:
            continue
        mountpoint = fields[4]
        if not mountpoint.startswith(prefixes):
            continue
        if "tmpfs" not in right:
            continue
        result = subprocess.run(["umount", "-l", mountpoint], capture_output=True, text=True)
        if result.returncode != 0:
            print(f"cannot unmount {mountpoint}: {result.stderr.strip()}", file=sys.stderr, flush=True)


def clock_mhz() -> int | None:
    """Real GFX clock in MHz, preferring the governor's SMU reading.

    The BC-250 8-core unlock corrupts the clock reporting, so the userspace SMU
    governor republishes the real value over the host's hwmon attribute - the
    same number amdgpu_top shows. Reading it through HOST_ROOT follows the
    governor's live overlays, including the ones it re-creates on restart. The
    raw table is only a fallback for hosts without the governor.
    """
    global CLOCK_CACHE
    hz = 0
    for candidate in (CLOCK_CACHE, host_freq_path()):
        if candidate is None:
            continue
        try:
            hz = int(candidate.read_text().strip())
        except (OSError, ValueError):
            CLOCK_CACHE = None
            continue
        CLOCK_CACHE = candidate
        break
    mhz = round(hz / 1_000_000)
    if CLOCK_MIN_MHZ <= mhz <= CLOCK_MAX_MHZ:
        return mhz
    try:
        table = METRICS_REAL.read_bytes()
    except OSError:
        return None
    if len(table) < GFXCLK_OFFSET + 2:
        return None
    value = table[GFXCLK_OFFSET] | (table[GFXCLK_OFFSET + 1] << 8)
    return value if CLOCK_MIN_MHZ <= value <= CLOCK_MAX_MHZ else None


def host_freq_path() -> Path | None:
    """`freq1_input` of the amdgpu hwmon as seen by the host."""
    for entry in (HOST_ROOT / "sys/class/hwmon").glob("hwmon*"):
        try:
            if (entry / "name").read_text().strip() != "amdgpu":
                continue
        except OSError:
            continue
        candidate = entry / "freq1_input"
        if candidate.exists():
            return candidate
    return None


def amdgpu_hwmon_freq() -> Path | None:
    """Path of the amdgpu hwmon `freq1_input`, whose reads are unreliable."""
    for entry in HWMON_ROOT.glob("hwmon*"):
        try:
            if (entry / "name").read_text().strip() != "amdgpu":
                continue
        except OSError:
            continue
        candidate = entry / "freq1_input"
        if candidate.exists():
            return candidate
    return None


def shadow_freq(target: Path) -> None:
    """Bind our own file over the glitchy sysfs attribute (idempotent).

    `freq1_input` returns anything from 2 to 2000 MHz on this board, so the
    overlays flicker through nonsense values. The mount is namespace-local.
    """
    if not FREQ_OUT.exists() or FREQ_OUT.stat().st_size < 2:
        FREQ_OUT.write_text("0\n")
    try:
        if target.stat().st_ino == FREQ_OUT.stat().st_ino:
            return
    except OSError:
        return
    result = subprocess.run(
        ["mount", "--bind", str(FREQ_OUT), str(target)],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        print(f"cannot shadow {target}: {result.stderr.strip()}", file=sys.stderr, flush=True)


def publish_freq(mhz: int) -> None:
    with open(FREQ_OUT, "r+b") as handle:
        handle.seek(0)
        payload = f"{mhz * 1_000_000}\n".encode()
        handle.write(payload)
        handle.truncate(len(payload))


def publish_metrics(percent: int, clock: int | None) -> None:
    """Rewrite the shadowed table: measured activity plus the real clock."""
    try:
        table = bytearray(METRICS_REAL.read_bytes())
    except OSError:
        return
    if len(table) < GFXCLK_OFFSET + 2:
        return
    table[ACTIVITY_OFFSET] = percent & 0xFF
    table[ACTIVITY_OFFSET + 1] = (percent >> 8) & 0xFF
    if clock is not None:
        value = clock.to_bytes(2, "little")
        table[AVG_GFXCLK_OFFSET:AVG_GFXCLK_OFFSET + 2] = value
        table[GFXCLK_OFFSET:GFXCLK_OFFSET + 2] = value
    if not METRICS_OUT.exists() or METRICS_OUT.stat().st_size != len(table):
        METRICS_OUT.write_bytes(bytes(table))
        return
    with open(METRICS_OUT, "r+b") as handle:
        handle.seek(0)
        handle.write(bytes(table))


def main() -> int:
    drop_stale_shadows()
    OUT.parent.mkdir(parents=True, exist_ok=True)
    if not OUT.exists() or OUT.stat().st_size != WIDTH:
        OUT.write_bytes(b"00\n")
    freq_path = amdgpu_hwmon_freq()
    clock = clock_mhz()
    publish_metrics(0, clock)
    if freq_path is not None:
        shadow_freq(freq_path)
        if clock:
            publish_freq(clock)

    previous = snapshot()
    last = time.monotonic()
    # True while the driver supplies the value, so the fdinfo baseline has to be
    # re-taken before deltas can be trusted again.
    stale = False

    while True:
        time.sleep(INTERVAL)
        now = time.monotonic()
        elapsed = now - last
        last = now

        percent = driver_activity()
        if percent is None:
            current = snapshot()
            if stale:
                previous = current
                stale = False
                percent = 0
            else:
                total = 0
                for key, value in current.items():
                    before = previous.get(key)
                    if before is None or value < before:
                        continue
                    total += value - before
                previous = current
                percent = 0
                if elapsed > 0:
                    percent = min(100, int(total * 100 / (elapsed * 1_000_000_000)))
        else:
            stale = True

        try:
            if freq_path is not None:
                shadow_freq(freq_path)
            clock = clock_mhz()
            publish(percent)
            publish_metrics(percent, clock)
            if clock and freq_path is not None:
                publish_freq(clock)
        except OSError as exc:
            print(f"cannot publish metrics: {exc}", file=sys.stderr, flush=True)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(0)
