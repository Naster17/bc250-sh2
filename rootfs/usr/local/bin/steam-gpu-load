#!/usr/bin/env python3
"""Publish AMD GPU utilisation for the performance overlay.

The overlay in gaming mode is MangoHud (`mangoapp`, spawned by gamescope), and
Steam's own overlay reads the same sysfs node. Both want a percentage that the
BC-250 cannot provide directly:

  * `/sys/class/drm/card0/device/gpu_busy_percent` — the amdgpu driver answers
    this read with `EOPNOTSUPP` on GFX1013 (no per-ASIC switch exists);
  * `/sys/class/drm/card0/device/gpu_metrics` — a 128-byte binary table whose
    `average_gfx_activity` (offset 28, `format_revision=2`) is `0xFFFF` whenever
    the SMU has no sample. MangoHud divides anything above 100 by 100
    (centipercent heuristic), so a single `0xFFFF` renders as `655%`, and it
    prefers this table over `gpu_busy_percent` on every poll.

This daemon keeps both files sane inside the container (bind-mounted shadows,
see docker-compose.yml):

  * `gpu_metrics` is rewritten every cycle from the real table: temperatures,
    clocks and power pass through untouched, only the activity field is
    replaced. The percentage comes from the driver's own centipercent value when
    it is valid — that is exactly what amdgpu_top displays — and from the
    per-client `drm-engine-gfx` counters in `/proc/<pid>/fdinfo/<fd>` when the
    SMU reports `0xFFFF`. Counters are de-duplicated by `drm-client-id`: every
    descriptor of a client repeats the same cumulative value, and summing per fd
    inflates the result several times over.
  * `gpu_busy_percent` gets the same percentage as plain text for readers that
    use it (Steam's overlay, MangoHud's sysfs fallback).

Values are written in place at a fixed width so a concurrent reader never sees a
truncated file.
"""

from __future__ import annotations

import os
import sys
import time
from pathlib import Path

OUT = Path(os.environ.get("GPU_LOAD_FILE", "/run/gpu-metrics/gpu_busy_percent"))
METRICS_REAL = Path(os.environ.get("GPU_METRICS_REAL", "/run/gpu-device/gpu_metrics"))
METRICS_OUT = Path(os.environ.get("GPU_METRICS_FILE", "/run/gpu-metrics/gpu_metrics"))
INTERVAL = float(os.environ.get("GPU_LOAD_INTERVAL", "0.5"))

# `average_gfx_activity` in the 128-byte v2.x table: header 4 + gfx/soc
# temperature 4 + core temperatures 16 + l3 temperatures 4.
ACTIVITY_OFFSET = 28

ENGINE = b"drm-engine-gfx:"
CLIENT = b"drm-client-id:"
WIDTH = 3  # "NN\n"


def driver_activity() -> int | None:
    """GPU load in percent from the driver table, or None when invalid.

    amdgpu reports centipercent (5470 == 54.70%) and 0xFFFF for "no sample".
    """
    try:
        table = METRICS_REAL.read_bytes()
    except OSError:
        return None
    if len(table) < ACTIVITY_OFFSET + 2:
        return None
    raw = table[ACTIVITY_OFFSET] | (table[ACTIVITY_OFFSET + 1] << 8)
    if raw == 0xFFFF:
        return None
    return min(100, (raw + 50) // 100)


def snapshot() -> dict[tuple, int]:
    """Cumulative gfx engine time (ns) per DRM client in this namespace."""
    usage: dict[tuple, int] = {}
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit():
            continue
        pid = int(entry.name)
        fdinfo = entry / "fdinfo"
        try:
            fds = os.listdir(fdinfo)
        except OSError:
            continue
        for fd in fds:
            try:
                with open(fdinfo / fd, "rb") as handle:
                    data = handle.read()
            except OSError:
                continue
            if ENGINE not in data:
                continue
            client = None
            engine = None
            for line in data.splitlines():
                if client is None and line.startswith(CLIENT):
                    client = line[len(CLIENT):].strip()
                elif engine is None and line.startswith(ENGINE):
                    value = line[len(ENGINE):].strip()
                    if value.endswith(b" ns"):
                        value = value[:-3]
                    try:
                        engine = int(value)
                    except ValueError:
                        engine = None
            if engine is None:
                continue
            key = ("client", client) if client else ("fd", pid, int(fd))
            usage[key] = engine
    return usage


def publish(percent: int) -> None:
    payload = f"{percent:02d}\n".encode()
    with open(OUT, "r+b") as handle:
        handle.seek(0)
        handle.write(payload)
        handle.truncate(WIDTH)


def publish_metrics(percent: int) -> None:
    """Rewrite the shadowed table with the measured activity percentage."""
    try:
        table = bytearray(METRICS_REAL.read_bytes())
    except OSError:
        return
    if len(table) < ACTIVITY_OFFSET + 2:
        return
    table[ACTIVITY_OFFSET] = percent & 0xFF
    table[ACTIVITY_OFFSET + 1] = (percent >> 8) & 0xFF
    if not METRICS_OUT.exists() or METRICS_OUT.stat().st_size != len(table):
        METRICS_OUT.write_bytes(bytes(table))
        return
    with open(METRICS_OUT, "r+b") as handle:
        handle.seek(0)
        handle.write(bytes(table))


def main() -> int:
    OUT.parent.mkdir(parents=True, exist_ok=True)
    if not OUT.exists() or OUT.stat().st_size != WIDTH:
        OUT.write_bytes(b"00\n")
    publish_metrics(0)

    previous = snapshot()
    last = time.monotonic()
    # True while the driver supplies the value, so the fdinfo baseline has to be
    # re-taken before deltas can be trusted again.
    stale = False

    while True:
        time.sleep(INTERVAL)
        now = time.monotonic()
        elapsed = now - last
        last = now

        percent = driver_activity()
        if percent is None:
            current = snapshot()
            if stale:
                previous = current
                stale = False
                percent = 0
            else:
                total = 0
                for key, value in current.items():
                    before = previous.get(key)
                    if before is None or value < before:
                        continue
                    total += value - before
                previous = current
                percent = 0
                if elapsed > 0:
                    percent = min(100, int(total * 100 / (elapsed * 1_000_000_000)))
        else:
            stale = True

        try:
            publish(percent)
            publish_metrics(percent)
        except OSError as exc:
            print(f"cannot publish metrics: {exc}", file=sys.stderr, flush=True)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(0)
