#!/usr/bin/env python3
"""Add "long press Select -> Quick Access Menu" to Steam's shipped controller configs.

Steam's default layouts map the physical Back/Select button to SELECT with a plain
Full_Press activator only. We insert one extra activator:

    "Long_Press" { binding "controller_action system_key_1" ; long_press_time 500 }

`system_key_1` is Steam's Quick Access Menu action (the right-hand panel with
Performance, Friends, notifications) - the same action the stock Xbox chord config
binds to Guide+A in chord_xboxone.vdf.

Which input is Select? Valve's naming is inverted relative to the printed labels.
In the shipped layouts (`basicui.vdf`, `basicui_gamepad.vdf`, `desktop_xboxone.vdf`):

    "button_escape"  ->  game_action Default START   /  key_press ESCAPE   (Start)
    "button_menu"    ->  game_action Default SELECT  /  key_press TAB      (Select)

so the physical Select button is the `"button_menu"` input, and the physical Start
button is `"button_escape"`. Binding the long press to `button_escape` opens the
Quick Access Menu on Start instead of Select. TARGET_INPUT below is therefore
`"button_menu"`.

Two hard requirements learned the hard way:

1. The result must stay valid KeyValues *and* keep its byte size. Steam verifies
   controller_base against its depot manifest at startup
   ("BVerifyInstalledFiles: ... is N bytes, expected M") and re-extracts
   mismatching files, so every file must keep its exact original length.
   KeyValues ignores whitespace: after inserting the activator we remove exactly
   as many leading indentation characters as we added.
2. The activator must not duplicate an existing one. Some stock inputs already
   carry a Long_Press binding; adding a second one makes Steam fail with
   "CPrepareConfigWorker failed for AppID 769" and the gamepad stops working
   entirely. Those inputs are skipped.

Everything is validated with a built-in KeyValues parser before anything is
written; a file that does not parse, or that ends up with duplicate activators,
is left untouched. Blocks are first removed wherever they already are, so
changing TARGET_INPUT retargets an already patched file in place (same bytes in,
same bytes out).

Short presses are untouched: an extra activator does not change Full_Press.
The script is idempotent and is re-run from /usr/local/sh-init.d on every boot.

Usage: steam-controller-patch [--steam-home DIR] [--dry-run] [--verbose]
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

TARGETS = (
    "basicui.vdf",
    "basicui_gamepad.vdf",
    "desktop_xboxone.vdf",
    "templates/controller_xboxone_gamepad_joystick.vdf",
)

MARKER = "system_key_1"
TARGET_INPUT = '"button_menu"'
LONG_PRESS_MS = "500"


class KVError(Exception):
    pass


def tokenize(text: str):
    i, n = 0, len(text)
    while i < n:
        c = text[i]
        if c in " \t\r\n":
            i += 1
            continue
        if c == "/" and i + 1 < n and text[i + 1] == "/":
            while i < n and text[i] != "\n":
                i += 1
            continue
        if c in "{}":
            yield c, c
            i += 1
            continue
        if c == '"':
            i += 1
            buf = []
            while i < n and text[i] != '"':
                if text[i] == "\\" and i + 1 < n:
                    i += 1
                buf.append(text[i])
                i += 1
            if i >= n:
                raise KVError("unterminated string")
            i += 1
            yield "str", "".join(buf)
            continue
        raise KVError(f"unexpected character {c!r} at offset {i}")


def validate(text: str) -> None:
    """Raise KVError unless the text is KeyValues Steam can load."""
    tokens = list(tokenize(text))
    pos = 0
    depth = 0

    while pos < len(tokens):
        kind, value = tokens[pos]
        if kind == "}":
            depth -= 1
            if depth < 0:
                raise KVError("unbalanced closing brace")
            pos += 1
            continue
        if kind != "str":
            raise KVError(f"expected key, got {value!r}")
        key = value
        pos += 1
        if pos >= len(tokens):
            raise KVError(f"key {key!r} without a value")
        kind2, value2 = tokens[pos]
        if kind2 == "{":
            if key == "activators":
                names: dict[str, int] = {}
                inner = pos + 1
                inner_depth = 1
                while inner < len(tokens) and inner_depth:
                    k2, v2 = tokens[inner]
                    if k2 == "{":
                        inner_depth += 1
                    elif k2 == "}":
                        inner_depth -= 1
                    elif inner_depth == 1 and k2 == "str":
                        names[v2] = names.get(v2, 0) + 1
                    inner += 1
                for name, count in names.items():
                    if count > 1:
                        raise KVError(f"duplicate activator {name!r}")
            depth += 1
            pos += 1
        elif kind2 == "str":
            pos += 1
        else:
            raise KVError(f"unexpected token {value2!r} after key {key!r}")

    if depth:
        raise KVError("unbalanced opening brace")


def block_for(newline: str) -> str:
    lines = [
        '\t\t\t\t\t"Long_Press"',
        "\t\t\t\t\t{",
        '\t\t\t\t\t\t"bindings"',
        "\t\t\t\t\t\t{",
        '\t\t\t\t\t\t\t"binding"\t\t"controller_action system_key_1"',
        "\t\t\t\t\t\t}",
        '\t\t\t\t\t\t"settings"',
        "\t\t\t\t\t\t{",
        f'\t\t\t\t\t\t\t"long_press_time"\t\t"{LONG_PRESS_MS}"',
        "\t\t\t\t\t\t}",
        "\t\t\t\t\t}",
    ]
    return newline.join(lines) + newline


def enclosing_key(lines: list[str], index: int) -> str | None:
    """Key of the block that contains line `index`."""
    depth = 0
    for k in range(index - 1, -1, -1):
        s = lines[k].strip()
        if s == "}":
            depth += 1
        elif s == "{":
            if depth == 0:
                for j in range(k - 1, -1, -1):
                    candidate = lines[j].strip()
                    if candidate:
                        return candidate
                return None
            depth -= 1
    return None


def strip_blocks(lines: list[str]) -> tuple[list[str], int]:
    """Remove marker blocks that are misplaced or carry a stale long-press time."""
    drop = [False] * len(lines)
    removed = 0
    i = 0
    while i < len(lines):
        if "controller_action system_key_1" not in lines[i]:
            i += 1
            continue

        start = None
        for k in range(i, max(-1, i - 6), -1):
            if lines[k].strip() == '"Long_Press"':
                start = k
                break
        if start is None:
            i += 1
            continue

        depth = 0
        opened = False
        end = None
        for j in range(start, len(lines)):
            s = lines[j].strip()
            if "{" in s:
                opened = True
            depth += s.count("{") - s.count("}")
            if opened and depth <= 0:
                end = j
                break
        if end is None:
            i += 1
            continue

        body = "".join(lines[start:end + 1])
        up_to_date = f'"{LONG_PRESS_MS}"' in body
        # innermost block around the line above Long_Press is the input itself
        if up_to_date and enclosing_key(lines, start - 1) == TARGET_INPUT:
            i += 1
            continue

        for k in range(start, end + 1):
            drop[k] = True
        removed += 1
        i = end + 1

    return [line for index, line in enumerate(lines) if not drop[index]], removed


def activators_of(lines: list[str], start: int) -> tuple[int, int] | None:
    """Return (brace_index, body_end) of the activators block opening at `start`."""
    depth = 0
    opened = False
    for j in range(start, len(lines)):
        s = lines[j].strip()
        if "{" in s:
            opened = True
        depth += s.count("{") - s.count("}")
        if opened and depth <= 0:
            return start, j
    return None


def insert_block(lines: list[str], newline: str) -> tuple[list[str], int, int]:
    """Insert the activator into TARGET_INPUT. Returns (lines, inserted, skipped)."""
    out: list[str] = []
    inserted = 0
    skipped = 0
    i = 0
    while i < len(lines):
        out.append(lines[i])
        if lines[i].strip() != TARGET_INPUT:
            i += 1
            continue

        # locate this input's own activators block, not a sibling's
        j = i + 1
        if j >= len(lines) or lines[j].strip() != "{":
            i += 1
            continue
        body_start = j
        found = None
        depth = 0
        k = j
        while k < len(lines):
            s = lines[k].strip()
            depth += s.count("{") - s.count("}")
            if k > body_start and s == '"activators"' and depth == 1:
                if k + 1 < len(lines) and lines[k + 1].strip() == "{":
                    found = k + 1
                    break
            if depth <= 0:
                break
            k += 1
        if found is None:
            i += 1
            continue

        span = activators_of(lines, found)
        if span is None:
            i += 1
            continue
        _brace, body_end = span
        body = "".join(lines[found:body_end + 1])

        while i < found:                      # copy up to and including the brace
            i += 1
            out.append(lines[i])

        if MARKER in body or '"Long_Press"' in body:
            skipped += 1
        else:
            out.append(block_for(newline))
            inserted += 1
        i += 1

    return out, inserted, skipped


def patch(path: Path, dry_run: bool, verbose: bool) -> tuple[int, str]:
    raw = path.read_bytes()
    original_size = len(raw)
    text = raw.decode("utf-8", "surrogateescape")
    newline = "\r\n" if "\r\n" in text else "\n"

    lines, removed = strip_blocks(text.splitlines(keepends=True))
    if removed and verbose:
        print(f"  {path.name}: removed {removed} stale blocks")

    lines, inserted, skipped = insert_block(lines, newline)
    patched = "".join(lines)
    delta = len(patched.encode("utf-8", "surrogateescape")) - original_size

    if not inserted and not removed:
        return 0, f"nothing to do ({skipped} inputs already covered, {original_size} bytes)"

    try:
        validate(patched)
    except KVError as exc:
        return 0, f"refusing to write, invalid result: {exc}"

    if delta > 0:
        balanced = patched.splitlines(keepends=True)
        remaining = delta
        for index, line in enumerate(balanced):
            if remaining <= 0:
                break
            body = line.rstrip("\r\n")
            indent = len(body) - len(body.lstrip(" \t"))
            if indent <= 0:
                continue
            take = min(indent, remaining)
            balanced[index] = line[take:]
            remaining -= take
        patched = "".join(balanced)
        if remaining:
            return 0, f"cannot balance size, {remaining} bytes short"
        try:
            validate(patched)
        except KVError as exc:
            return 0, f"refusing to write, invalid after balancing: {exc}"
    elif delta < 0:
        patched = patched + " " * (-delta)

    final_size = len(patched.encode("utf-8", "surrogateescape"))
    if final_size != original_size:
        return 0, f"refusing to write: size {final_size} != original {original_size}"

    if not dry_run:
        path.write_bytes(patched.encode("utf-8", "surrogateescape"))
    note = f"size kept at {final_size} bytes"
    if removed:
        note += f", {removed} blocks retargeted"
    if skipped:
        note += f", {skipped} inputs skipped"
    return inserted, note


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--steam-home", default="/home/steamheadless/.local/share/Steam")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--verbose", action="store_true")
    args = parser.parse_args()

    base = Path(args.steam_home) / "controller_base"
    if not base.is_dir():
        print(f"no controller_base at {base}", file=sys.stderr)
        return 1

    total = 0
    for rel in TARGETS:
        target = base / rel
        if not target.is_file():
            print(f"skip {rel} (missing)")
            continue
        count, note = patch(target, args.dry_run, args.verbose)
        total += count
        print(f"{rel}: {count} inserts, {note}")

    print(f"total inserts: {total}{' (dry run)' if args.dry_run else ''}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
