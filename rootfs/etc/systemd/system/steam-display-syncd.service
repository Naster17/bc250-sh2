[Unit]
Description=Steam Headless dynamic display mode daemon
Documentation=https://github.com/Naster17/bc250-sh2
After=steam-headless-compositor.service
Before=steam-headless-sunshine.service

[Service]
Type=simple
ExecStart=/usr/local/bin/steam-display-syncd
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
