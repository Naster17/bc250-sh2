[Unit]
Description=Steam Headless dynamic display mode daemon
Documentation=https://github.com/Naster17/steam-headless-bc250
After=steam-headless-compositor.service
Before=steam-headless-sunshine.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/steam-display-syncd
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
