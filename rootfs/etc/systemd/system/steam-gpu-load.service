[Unit]
Description=Publish AMD GPU utilisation for Steam's performance overlay
Documentation=https://github.com/Naster17/bc250-sh2
# The amdgpu driver on the BC-250 does not support gpu_busy_percent, so Steam's
# overlay reads a file this service keeps up to date. Nothing here depends on
# Steam; it only needs the bind-mounted metrics file from docker-compose.yml.
After=local-fs.target
# The overlay (mangoapp) opens freq1_input once at startup and keeps the
# descriptor, so the bind mount has to exist before the compositor spawns it.
# Otherwise the overlay reads the raw attribute, which on this board returns
# 2..100 MHz at random, and the clock line stays broken until it is restarted.
Before=steam-headless-gamescope.service steam-headless-steam.service

[Service]
Type=simple
ExecStart=/usr/local/bin/steam-gpu-load
Restart=always
RestartSec=2
Nice=5

[Install]
WantedBy=multi-user.target
