# Copy to .env and adjust. Used by docker-compose.yml.

# Host directory holding the persistent data. Set this for your site; the
# deployment's actual value is recorded in docs/site.md.
#   data/home  -> /home/steamheadless  (Steam, Proton prefixes, Sunshine config)
#   state      -> /var/lib/steam-headless (auth state, TLS certs)
#   journal    -> /var/log/journal
#   games      -> /mnt/games (Steam library)
SH2_DIR=/opt/steam-headless

# Owner of the container's steamheadless user; must match `id -u` / `id -g`
# of the host user owning SH2_DIR.
PUID=1000
PGID=1000

# Set to your site's timezone; docs/site.md records this deployment's value.
TZ=UTC

# Apply the resolution/refresh requested by each Moonlight client to the KWin
# virtual output and to gamescope, so the game renders at the client's mode
# instead of Sunshine scaling the current desktop. Changing the mode restarts
# Steam and gamescope for the new stream. Set false to keep one fixed mode.
STEAM_HEADLESS_DYNAMIC_DISPLAY=true

# Deployment target for `make deploy` (not read by the container).
# Leave DEPLOY_HOST empty until it is set here or on the make command line.
DEPLOY_HOST=
DEPLOY_DIR=~/steam-headless-bc250
